{
  "name": "@rub1cc/pi-adaptive-scroll",
  "version": "0.1.1",
  "description": "Precise slow scrolling and adaptive acceleration for Pi's fullscreen transcript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rub1cc/pi-adaptive-scroll.git"
  },
  "type": "module",
  "files": [
    "index.ts",
    "acceleration.ts",
    "wheel-hook.ts",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
